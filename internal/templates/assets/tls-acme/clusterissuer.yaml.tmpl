# cert-manager ClusterIssuer for automated TLS via ACME (e.g. Let's Encrypt).
# cert-manager is installed as part of k0rdent Enterprise, so apply this AFTER
# the kcm install (step 3). Generated by airgapdeploy.
#
# AIR-GAP NOTE: public Let's Encrypt requires outbound reach to the ACME server
# AND that the ACME server can reach your ingress for the HTTP-01 challenge. In
# a fully isolated air-gap, point acmeServer at an internal ACME endpoint
# (e.g. step-ca, HashiCorp Vault, or Windows CA with the ACME role) instead.
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{.ACMEIssuerName}}
spec:
  acme:
    server: {{.ACMEServer}}
    email: {{.ACMEEmail}}
    privateKeySecretRef:
      name: {{.ACMEIssuerName}}-account-key
    solvers:
    - http01:
        ingress:
{{- if .ACMEIngressClass}}
          ingressClassName: {{.ACMEIngressClass}}
{{- else}}
          # ingressClassName omitted -> cert-manager uses the default ingress class.
          {}
{{- end}}
