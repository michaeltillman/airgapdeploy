# cert-manager Certificate: automatically issues and renews a serving cert for
# the registry / fileserver hostnames using the ACME ClusterIssuer.
# Generated by airgapdeploy.
#
# The resulting `registry-serving-tls` secret (type kubernetes.io/tls) is what
# you point your registry / fileserver INGRESS at — cert-manager keeps it
# renewed automatically. Because these are publicly-trusted certs, the cluster
# does not need a registryCertSecret (no manual CA to trust).
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: registry-serving-tls
  namespace: {{.Namespace}}
spec:
  secretName: registry-serving-tls
  issuerRef:
    name: {{.ACMEIssuerName}}
    kind: ClusterIssuer
  dnsNames:
{{- range .TLSDomains}}
  - {{.}}
{{- end}}
