# k0s-fileserver: namespace + persistent storage for the k0s binary.
# Generated by airgapdeploy.
apiVersion: v1
kind: Namespace
metadata:
  name: {{.FileserverNamespace}}
---
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: k0s-fileserver-data
  namespace: {{.FileserverNamespace}}
spec:
  accessModes:
  - ReadWriteOnce
  resources:
    requests:
      storage: {{.PVCSize}}
{{- if .StorageClass}}
  storageClassName: {{.StorageClass}}
{{- else}}
  # storageClassName omitted -> uses the cluster default StorageClass.
  # Set `storageClass` in your config to pin a specific class.
{{- end}}
