#!/usr/bin/env bash
#
# load-k0s.sh  —  AIRGAPPED CLUSTER SIDE
#
# Copies the k0s binary into the fileserver PVC via a temporary loader pod,
# then removes the loader. Run AFTER applying namespace-pvc.yaml and
# binary-loader.yaml. Generated by airgapdeploy.
#
# IMPORTANT: Do not rename the k0s binary — child cluster deployment relies on
# the exact filename.
set -euo pipefail

NS="{{.FileserverNamespace}}"
# The k0s binary to serve. Defaults to the first configured architecture.
K0S_BINARY="${K0S_BINARY:-{{.PrimaryK0sBinary}}}"

if [[ ! -f "${K0S_BINARY}" ]]; then
  echo "ERROR: ${K0S_BINARY} not found in $(pwd)." >&2
  echo "Copy the k0s binary produced by 01-prepare.sh into this directory first." >&2
  exit 1
fi

echo "==> Waiting for binary-loader pod to be Ready"
kubectl wait --for=condition=Ready pod/binary-loader -n "${NS}" --timeout=120s

echo "==> Creating target directory in the PVC"
kubectl exec -n "${NS}" binary-loader -- mkdir -p /data/{{.RegistryProject}}

echo "==> Copying ${K0S_BINARY} into the PVC"
kubectl cp "${K0S_BINARY}" "${NS}/binary-loader:/data/{{.RegistryProject}}/"

echo "==> Removing the loader pod"
kubectl delete pod binary-loader -n "${NS}"

echo ""
echo "==> DONE. Now apply configmap-nginx.yaml and deployment-service.yaml,"
echo "    then read the external IP with:"
echo "      kubectl get svc k0s-fileserver -n ${NS} --watch"
