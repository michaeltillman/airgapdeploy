# busybox httpd Deployment + LoadBalancer Service serving the k0s binary over HTTP.
# busybox is already mirrored by 01-prepare.sh (it ships in the k0rdent airgap
# bundle), so the fileserver needs no separately-mirrored image. Generated by
# airgapdeploy.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: k0s-fileserver
  namespace: {{.FileserverNamespace}}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: k0s-fileserver
  template:
    metadata:
      labels:
        app: k0s-fileserver
    spec:
      containers:
      - name: httpd
        image: {{.BusyboxImageRef}}
        # busybox httpd: foreground (-f), verbose (-v), port 8080, docroot.
        # Port 8080 is unprivileged so the pod need not run as root.
        command: ["httpd", "-f", "-v", "-p", "8080", "-h", "/var/www/html"]
        ports:
        - containerPort: 8080
        readinessProbe:
          tcpSocket:
            port: 8080
          initialDelaySeconds: 3
          periodSeconds: 10
        livenessProbe:
          tcpSocket:
            port: 8080
          initialDelaySeconds: 5
          periodSeconds: 20
        volumeMounts:
        - name: files
          mountPath: /var/www/html
      volumes:
      - name: files
        persistentVolumeClaim:
          claimName: k0s-fileserver-data
---
apiVersion: v1
kind: Service
metadata:
  name: k0s-fileserver
  namespace: {{.FileserverNamespace}}
spec:
  type: LoadBalancer
  ports:
  - name: http
    port: 80
    protocol: TCP
    targetPort: 8080
  selector:
    app: k0s-fileserver
