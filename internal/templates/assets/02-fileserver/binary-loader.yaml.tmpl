# Temporary pod used to copy the k0s binary into the fileserver PVC.
# Delete it once load-k0s.sh completes. Generated by airgapdeploy.
apiVersion: v1
kind: Pod
metadata:
  name: binary-loader
  namespace: {{.FileserverNamespace}}
spec:
  restartPolicy: Never
  containers:
  - name: loader
    image: {{.BusyboxImageRef}}
    command: ["sh", "-c", "sleep 3600"]
    volumeMounts:
    - name: files
      mountPath: /data
  volumes:
  - name: files
    persistentVolumeClaim:
      claimName: k0s-fileserver-data
