# nginx config for the k0s fileserver: directory listing + health endpoint.
# Generated by airgapdeploy.
apiVersion: v1
kind: ConfigMap
metadata:
  name: k0s-fileserver-config
  namespace: {{.FileserverNamespace}}
data:
  default.conf: |
    server {
      listen 80;
      server_name _;
      root /var/www/html;
      sendfile on;
      tcp_nopush on;
      tcp_nodelay on;
      keepalive_timeout 70;
      client_max_body_size 512m;
      proxy_max_temp_file_size 0;
      location / {
        autoindex on;
      }
      location /healthz {
        return 200 'OK';
        add_header Content-Type text/plain;
      }
    }
