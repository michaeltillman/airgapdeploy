#!/usr/bin/env bash
#
# 01-prepare.sh  —  INTERNET-CONNECTED PREP MACHINE
#
# Downloads the k0rdent Enterprise airgap bundle and k0s binaries, verifies
# their cosign signatures, then pushes all images and charts into your private
# OCI registry using the bundled skopeo.
#
# Generated by airgapdeploy for k0rdent Enterprise {{.KcmVersion}}.
# Run this on a machine that HAS internet access AND can reach your registry.
#
# Prerequisites on this machine: bash>=4.2, GNU coreutils, tar>=1.34, wget,
# docker (to run bundled skopeo), cosign>=2.4.1.
set -euo pipefail

# ---- Configuration (edit here or override via environment) ------------------
export REGISTRY_HOST="${REGISTRY_HOST:-{{.RegistryHost}}}"
export REGISTRY="${REGISTRY:-${REGISTRY_HOST}/{{.RegistryProject}}}"
KCM_VERSION="${KCM_VERSION:-{{.KcmVersion}}}"
K0S_VERSION="${K0S_VERSION:-{{.K0sVersion}}}"
SKOPEO_VERSION="${SKOPEO_VERSION:-{{.SkopeoVersion}}}"
BUNDLE_BASE_URL="${BUNDLE_BASE_URL:-{{.BundleBaseURL}}}"
ARCHES=({{range $i, $a := .Architectures}}{{if $i}} {{end}}"{{$a}}"{{end}})

WORKDIR="${WORKDIR:-$(pwd)}"
BUNDLE="airgap-bundle-${KCM_VERSION}.tar.gz"
BUNDLE_DIR="${WORKDIR}/airgap-bundle"
COSIGN_PUB="${COSIGN_PUB:-${BUNDLE_BASE_URL}/cosign.pub}"
{{- if .UsesCustomTLS}}
# TLS mode: {{.TLSModeLabel}}. The push below verifies the registry certificate
# against this CA cert (skopeo --dest-cert-dir). Must be readable on this machine.
CA_CERT_PATH="${CA_CERT_PATH:-{{.CACertPath}}}"
{{- end}}

echo "==> Registry target: ${REGISTRY}"
echo "==> k0rdent Enterprise version: ${KCM_VERSION}"
echo "==> k0s version: ${K0S_VERSION}"

# ---- 1. Download the airgap bundle + signature ------------------------------
cd "${WORKDIR}"
if [[ ! -f "${BUNDLE}" ]]; then
  echo "==> Downloading ${BUNDLE}"
  wget -q --show-progress "${BUNDLE_BASE_URL}/${KCM_VERSION}/${BUNDLE}"
  wget -q --show-progress "${BUNDLE_BASE_URL}/${KCM_VERSION}/${BUNDLE}.sig"
else
  echo "==> ${BUNDLE} already present, skipping download"
fi

# ---- 2. Verify the bundle signature with cosign -----------------------------
# This prep machine has internet, so the online transparency-log check is fine.
# For a fully offline verification, download cosign.pub separately and consult
# the Mirantis docs for the current offline flag.
echo "==> Verifying ${BUNDLE} signature"
cosign verify-blob --key "${COSIGN_PUB}" \
  --signature "${BUNDLE}.sig" "${BUNDLE}"

# ---- 3. Extract the bundle --------------------------------------------------
echo "==> Extracting bundle into ${BUNDLE_DIR}"
mkdir -p "${BUNDLE_DIR}"
tar -xf "${BUNDLE}" -C "${BUNDLE_DIR}"

# ---- 4. Load the bundled skopeo image ---------------------------------------
echo "==> Loading skopeo ${SKOPEO_VERSION}"
docker load -i "${BUNDLE_DIR}/skopeo_${SKOPEO_VERSION}.tar"

# ---- 5. (Optional) authenticate to the registry -----------------------------
# The v1.4.0 airgap flow uses a NON-AUTHENTICATED registry, so no login is
# required. If your registry requires a login for pushes, uncomment:
# docker login "${REGISTRY_HOST}"

# ---- 6. Push all images and charts into the private registry ----------------
{{- if .UsesCustomTLS}}
if [[ ! -f "${CA_CERT_PATH}" ]]; then
  echo "ERROR: CA certificate not found at ${CA_CERT_PATH}." >&2
  echo "The push verifies the registry cert against this CA. Set CA_CERT_PATH and re-run." >&2
  exit 1
fi
# skopeo trusts *.crt files found in --dest-cert-dir; mount the CA cert as ca.crt.
CERT_DIR="$(mktemp -d)"
cp "${CA_CERT_PATH}" "${CERT_DIR}/ca.crt"
trap 'rm -rf "${CERT_DIR}"' EXIT
echo "==> Pushing images and charts to ${REGISTRY} (verifying against ${CA_CERT_PATH})"
{{- else}}
echo "==> Pushing images and charts to ${REGISTRY} (TLS verification disabled)"
{{- end}}
cd "${BUNDLE_DIR}"
for file in $(find . -type f ! -name 'skopeo*' | sed -s 's~^./~~g'); do
  echo "    -> ${file}"
  bn="${file%*.tar}"
  docker run --rm --network=host \
    -v "${HOME}/.docker/config.json:/config.json" \
    -v "${PWD}:/airgap-bundle" -w /airgap-bundle \
{{- if .UsesCustomTLS}}
    -v "${CERT_DIR}:/certs:ro" \
    "skopeo:${SKOPEO_VERSION}" copy -a --authfile /config.json \
    --insecure-policy --dest-tls-verify=true --dest-cert-dir /certs \
{{- else}}
    "skopeo:${SKOPEO_VERSION}" copy -a --authfile /config.json \
    --insecure-policy --dest-tls-verify=false \
{{- end}}
    "oci-archive:${file}" "docker://${REGISTRY}/${bn%_*}:${bn#*_}"
done
cd "${WORKDIR}"

# ---- 7. Download and verify the k0s binaries --------------------------------
echo "==> Downloading k0s binaries"
for arch in "${ARCHES[@]}"; do
  bin="k0s-${K0S_VERSION}-${arch}"
  if [[ ! -f "${bin}" ]]; then
    wget -q --show-progress "${BUNDLE_BASE_URL}/k0s/${bin}"
    wget -q --show-progress "${BUNDLE_BASE_URL}/k0s/${bin}.sig"
  fi
  echo "==> Verifying ${bin} signature"
  cosign verify-blob --key "${COSIGN_PUB}" \
    --signature "${bin}.sig" "${bin}"
done

echo ""
echo "==> DONE. Images/charts pushed to ${REGISTRY}."
echo "    k0s binaries downloaded to: ${WORKDIR}"
echo "    Next: move the k0s binaries into the airgap and run the fileserver step (02)."
