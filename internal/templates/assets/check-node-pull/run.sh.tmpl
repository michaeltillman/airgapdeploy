#!/usr/bin/env bash
#
# check-node-pull/run.sh  —  prove EVERY node can pull from the registry
#
# Applies the node-pull-test DaemonSet, waits for it to roll out, and reports
# per-node results. On failure it leaves the resources in place and prints the
# failing pods' images + events so you can see exactly which node and why.
# Generated by airgapdeploy.
set -uo pipefail

NS="airgap-preflight"
DIR="$(cd "$(dirname "$0")" && pwd)"
TIMEOUT="${TIMEOUT:-180s}"

echo "==> Applying per-node pull test"
kubectl apply -f "${DIR}/namespace-daemonset.yaml"

echo "==> Waiting up to ${TIMEOUT} for every node to pull the canary image"
if kubectl rollout status ds/node-pull-test -n "${NS}" --timeout="${TIMEOUT}"; then
  echo ""
  echo "==> SUCCESS: all nodes pulled the image."
  kubectl get pods -n "${NS}" -o wide
  echo "==> Cleaning up"
  kubectl delete -f "${DIR}/namespace-daemonset.yaml" --wait=false
  exit 0
fi

echo ""
echo "!! One or more nodes could NOT pull the image. Per-node status:"
kubectl get pods -n "${NS}" -o wide

echo ""
echo "!! Failing pods (image / reason / message) and recent events:"
kubectl get pods -n "${NS}" --no-headers 2>/dev/null \
  | awk '$3!="Running"{print $1}' \
  | while read -r pod; do
      node="$(kubectl get pod "${pod}" -n "${NS}" -o jsonpath='{.spec.nodeName}' 2>/dev/null)"
      echo "---- pod ${pod} on node ${node} ----"
      kubectl get pod "${pod}" -n "${NS}" -o jsonpath='{range .status.containerStatuses[*]}  image={.image}{"\n"}  reason={.state.waiting.reason}{"\n"}  message={.state.waiting.message}{"\n"}{end}' 2>/dev/null
      kubectl describe pod "${pod}" -n "${NS}" 2>/dev/null | sed -n '/Events:/,$p' | head -20
      echo ""
    done

echo "Resources left in place for debugging. Clean up when done with:"
echo "  kubectl delete -f ${DIR}/namespace-daemonset.yaml"
echo "Then run ../diagnose.sh and ../check-access.sh for more detail."
exit 1
