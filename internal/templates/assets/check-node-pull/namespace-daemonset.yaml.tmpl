# Per-node image pull test. The DaemonSet schedules one pod on EVERY node
# (including tainted control-plane nodes) and force-pulls a canary image from
# the private registry. If a node's container runtime cannot reach, trust, or
# pull from the registry, that node's pod will fail with ImagePullBackOff.
# Generated by airgapdeploy.
apiVersion: v1
kind: Namespace
metadata:
  name: airgap-preflight
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: node-pull-test
  namespace: airgap-preflight
  labels:
    app: node-pull-test
spec:
  selector:
    matchLabels:
      app: node-pull-test
  template:
    metadata:
      labels:
        app: node-pull-test
    spec:
      terminationGracePeriodSeconds: 1
      # Run on every node, including control-plane / otherwise-tainted nodes.
      tolerations:
      - operator: Exists
      containers:
      - name: pull
        # Canary image already mirrored into the registry (fileserver loader).
        image: {{.BusyboxImageRef}}
        imagePullPolicy: Always
        command: ["sh", "-c", "echo pulled-ok on $(hostname); sleep 3600"]
        resources:
          requests:
            cpu: 10m
            memory: 16Mi
{{- if .UsesCustomTLS}}
      # NOTE: nodes must trust the registry CA in their CONTAINER RUNTIME
      # (containerd) config — that is separate from the Kubernetes secret used
      # by the controller. If pods here fail with x509/certificate errors, the
      # node runtime is missing the CA. See the RUNBOOK "Node CA trust" note.
{{- end}}
