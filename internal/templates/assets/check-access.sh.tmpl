#!/usr/bin/env bash
#
# check-access.sh  —  validate registry + fileserver access / authorization
#
# Confirms this machine (and, by extension, nodes sharing its network + trust
# config) can REACH, TRUST, and PULL from the private registry, and reach the
# k0s fileserver. Run it on the prep machine (push path) AND on a cluster node
# or jump host (pull path). Generated by airgapdeploy.
#
# Exit code is non-zero if any check fails, so it is safe to gate automation on.
set -uo pipefail

REGISTRY_HOST="${REGISTRY_HOST:-{{.RegistryHost}}}"
REGISTRY_PROJECT="${REGISTRY_PROJECT:-{{.RegistryProject}}}"
REGISTRY_SCHEME="${REGISTRY_SCHEME:-https}"
FILESERVER_URL="${FILESERVER_URL:-{{.FileserverURL}}}"
K0S_BINARY="${K0S_BINARY:-{{.PrimaryK0sBinary}}}"
{{- if .UsesCustomTLS}}
CA_CERT_PATH="${CA_CERT_PATH:-{{.CACertPath}}}"
{{- end}}

host="${REGISTRY_HOST%%/*}"
case "${host}" in
  *:*) rhost="${host%:*}"; rport="${host##*:}" ;;
  *)   rhost="${host}"; if [[ "${REGISTRY_SCHEME}" == "http" ]]; then rport=80; else rport=443; fi ;;
esac

pass=0; fail=0
ok()  { echo "  [PASS] $*"; pass=$((pass+1)); }
bad() { echo "  [FAIL] $*"; fail=$((fail+1)); }

# curl that prints ONLY the HTTP status code (000 on any failure). Avoids the
# double-code bug from combining -w with a `|| echo`.
http_code() { local c; c="$(curl -s -o /dev/null -w '%{http_code}' "$@" 2>/dev/null)"; echo "${c:-000}"; }

echo "==> Registry ${REGISTRY_SCHEME}://${host} (project ${REGISTRY_PROJECT})"

# curl TLS options for the registry.
CURL_TLS=()
{{- if .UsesCustomTLS}}
if [[ -f "${CA_CERT_PATH}" ]]; then
  CURL_TLS=(--cacert "${CA_CERT_PATH}")
else
  bad "CA certificate not found at ${CA_CERT_PATH} (cannot verify TLS trust)"
fi
{{- else if .UsesACME}}
# ACME (publicly-trusted) certs: verify normally against the system trust store.
CURL_TLS=()
{{- else}}
# TLS mode "none": no custom CA. Probe insecurely so we still get a signal.
CURL_TLS=(-k)
{{- end}}

# 1. TCP reachability
if timeout 5 bash -c "cat < /dev/null > /dev/tcp/${rhost}/${rport}" 2>/dev/null; then
  ok "TCP connect to ${rhost}:${rport}"
else
  bad "cannot open TCP ${rhost}:${rport} (DNS, firewall, or registry down?)"
fi
{{- if .UsesCustomTLS}}

# 2. TLS trust: registry cert must verify against the CA
if command -v openssl >/dev/null 2>&1 && [[ -f "${CA_CERT_PATH}" ]]; then
  if echo | openssl s_client -connect "${rhost}:${rport}" -servername "${rhost}" \
       -CAfile "${CA_CERT_PATH}" 2>/dev/null | grep -q "Verify return code: 0 (ok)"; then
    ok "registry certificate verifies against ${CA_CERT_PATH}"
  else
    bad "registry certificate does NOT verify against ${CA_CERT_PATH} (nodes will get x509 errors)"
  fi
else
  echo "  [SKIP] openssl not available; cannot check TLS chain"
fi
{{- end}}

# 3. Registry v2 API
code="$(http_code ${CURL_TLS[@]+"${CURL_TLS[@]}"} "${REGISTRY_SCHEME}://${host}/v2/")"
case "${code}" in
  200|401) ok "registry /v2/ reachable (HTTP ${code})" ;;
  000)     bad "registry /v2/ unreachable (TLS or network failure)" ;;
  *)       bad "registry /v2/ returned HTTP ${code}" ;;
esac

# 4. Image presence — probe repos we know were mirrored (used by the fileserver)
check_repo() {
  local repo="$1"
  local c
  c="$(http_code ${CURL_TLS[@]+"${CURL_TLS[@]}"} "${REGISTRY_SCHEME}://${host}/v2/${repo}/tags/list")"
  if [[ "${c}" == "200" ]]; then
    ok "image repo '${repo}' present and listable"
  else
    bad "image repo '${repo}' missing or inaccessible (HTTP ${c}) — check the push (01-prepare.sh)"
  fi
}
check_repo "${REGISTRY_PROJECT}/busybox"
check_repo "nginx"

# 5. k0s binary fileserver
FS_TLS=()
{{- if .FileserverIsHTTPS}}
{{- if .UsesCustomTLS}}
[[ -f "${CA_CERT_PATH}" ]] && FS_TLS=(--cacert "${CA_CERT_PATH}")
{{- else if .UsesACME}}
FS_TLS=()
{{- else}}
FS_TLS=(-k)
{{- end}}
{{- end}}
fscode="$(http_code ${FS_TLS[@]+"${FS_TLS[@]}"} -I "${FILESERVER_URL}/${K0S_BINARY}")"
if [[ "${fscode}" == "200" ]]; then
  ok "k0s binary reachable: ${FILESERVER_URL}/${K0S_BINARY}"
else
  bad "k0s binary not reachable (HTTP ${fscode}) at ${FILESERVER_URL}/${K0S_BINARY}"
fi

echo ""
echo "==> ${pass} passed, ${fail} failed"
if [[ "${fail}" -ne 0 ]]; then
  echo "    See diagnose.sh for deeper cluster-side troubleshooting."
  exit 1
fi
