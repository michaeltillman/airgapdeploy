#!/usr/bin/env bash
#
# diagnose.sh  —  troubleshoot images that will not pull or install
#
# Surfaces image-pull failures, crashing pods, their events, the Helm release
# status, and Management/template readiness — the usual causes when an airgap
# install stalls. Read-only; safe to run repeatedly. Generated by airgapdeploy.
set -uo pipefail

NAMESPACE="${NAMESPACE:-{{.Namespace}}}"
EXTRA_NS="${EXTRA_NS:-projectsveltos}"
PULL_ERRORS='ImagePullBackOff|ErrImagePull|InvalidImageName|ImageInspectError|RegistryUnavailable|CreateContainerError|CrashLoopBackOff|Init:ErrImagePull|Init:ImagePullBackOff'

sep() { echo; echo "======== $* ========"; }

sep "Pods not Running/Completed in ${NAMESPACE} and ${EXTRA_NS}"
for ns in "${NAMESPACE}" "${EXTRA_NS}"; do
  echo "# namespace ${ns}"
  kubectl get pods -n "${ns}" -o wide 2>/dev/null \
    | awk 'NR==1 || ($3!="Running" && $3!="Completed")'
done

sep "Image pull / container errors (all namespaces)"
found=0
kubectl get pods -A --no-headers 2>/dev/null \
  | grep -E "${PULL_ERRORS}" \
  | while read -r ns pod _; do
      found=1
      echo "---- ${ns}/${pod} ----"
      # image + waiting reason/message per container (no jq required)
      kubectl get pod "${pod}" -n "${ns}" -o jsonpath='{range .status.containerStatuses[*]}  image={.image}{"\n"}  reason={.state.waiting.reason}{"\n"}  message={.state.waiting.message}{"\n"}{end}' 2>/dev/null
      kubectl describe pod "${pod}" -n "${ns}" 2>/dev/null | sed -n '/Events:/,$p' | head -20
      echo ""
    done
# Note: the while-loop runs in a subshell, so print the "none" hint separately.
if ! kubectl get pods -A --no-headers 2>/dev/null | grep -qE "${PULL_ERRORS}"; then
  echo "  none found"
fi

sep "Helm release 'kcm' status"
if command -v helm >/dev/null 2>&1; then
  helm -n "${NAMESPACE}" status kcm 2>/dev/null || echo "  release 'kcm' not found in ${NAMESPACE}"
else
  echo "  helm not installed on this machine"
fi

sep "Management readiness"
kubectl get management -n "${NAMESPACE}" 2>/dev/null || echo "  no Management object"

sep "Templates that are NOT valid"
echo "# ProviderTemplates"
kubectl get providertemplate -n "${NAMESPACE}" 2>/dev/null | awk 'NR==1 || tolower($0) !~ /true/'
echo "# ClusterTemplates"
kubectl get clustertemplate -n "${NAMESPACE}" 2>/dev/null | awk 'NR==1 || tolower($0) !~ /true/'

sep "Recent Warning events (last 30)"
kubectl get events -A --field-selector type=Warning --sort-by=.lastTimestamp 2>/dev/null | tail -30

sep "Next steps"
cat <<'TIPS'
  - Image missing/inaccessible in the registry  -> re-run 01-prepare.sh, then check-access.sh
  - x509 / certificate errors on nodes          -> node container runtime is missing the registry CA
  - Only some nodes fail                         -> run check-node-pull/run.sh to isolate them
  - Auth/401 from the registry                   -> this build targets a NON-authenticated registry
  - Wrong registry/fileserver values            -> inspect 03-values.yaml and reconcile with your endpoints
TIPS
