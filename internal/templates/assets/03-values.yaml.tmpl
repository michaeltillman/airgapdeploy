# kcm (k0rdent Enterprise) Helm values for a NON-AUTHENTICATED private registry.
# Generated by airgapdeploy for version {{.KcmVersion}}.
#
# Registry:   {{.Registry}}
# Charts:     {{.ChartsRepoURL}}
# k0s binary: {{.FileserverURL}}
controller:
  templatesRepoURL: "{{.ChartsRepoURL}}"
  globalRegistry: "{{.Registry}}"
  globalK0sURL: "{{.FileserverURL}}"
{{- if .UsesCustomTLS}}
  # TLS mode: {{.TLSModeLabel}}.
  # The controller trusts the registry via a secret containing ca.crt. That
  # secret ({{.CACertSecretName}}) is created before install (see 04-install.sh
  # and the RUNBOOK).
  registryCertSecret: "{{.CACertSecretName}}"
{{- if .FileserverIsHTTPS}}
  # k0s binary fileserver is HTTPS with the same CA, so it needs the secret too.
  k0sURLCertSecret: "{{.CACertSecretName}}"
{{- else}}
  # k0s fileserver URL is plain HTTP, so no k0sURLCertSecret is set. If you move
  # the fileserver to HTTPS, set fileserverURL to https:// and regenerate.
{{- end}}
{{- end}}

# Component subchart overrides so every dependency pulls from the private
# registry instead of upstream. Adjust image repositories here if your registry
# layout differs from the default mirror produced by 01-prepare.sh.
flux2:
  image:
    registry: "{{.Registry}}"
cert-manager:
  image:
    repository: "{{.Registry}}/cert-manager-controller"
  webhook:
    image:
      repository: "{{.Registry}}/cert-manager-webhook"
  cainjector:
    image:
      repository: "{{.Registry}}/cert-manager-cainjector"
  startupapicheck:
    image:
      repository: "{{.Registry}}/cert-manager-startupapicheck"
cluster-api-operator:
  image:
    manager:
      repository: "{{.Registry}}/cluster-api-operator"
velero:
  image:
    repository: "{{.Registry}}/velero"
rbac-manager:
  image:
    repository: "{{.Registry}}/rbac-manager"
k0rdent-ui:
  image:
    repository: "{{.Registry}}/k0rdent-ui"
