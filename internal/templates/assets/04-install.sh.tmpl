#!/usr/bin/env bash
#
# 04-install.sh  —  AIRGAPPED CLUSTER SIDE
#
# Installs k0rdent Enterprise (kcm) from your private OCI registry using the
# generated values file. Generated by airgapdeploy.
#
# Prerequisites: helm>=3.16.3 and kubectl configured against the management
# cluster (Kubernetes >= 1.30). Run the fileserver step (02) first.
set -euo pipefail

NAMESPACE="${NAMESPACE:-{{.Namespace}}}"
KCM_VERSION="${KCM_VERSION:-{{.KcmVersion}}}"
CHART="${CHART:-{{.ChartsRepoURL}}/k0rdent-enterprise}"
VALUES="${VALUES:-$(dirname "$0")/03-values.yaml}"
{{- if .SelfSignedCA}}

# --- Self-signed CA secret for the registry / fileserver ---------------------
# Create the CA secret before installing if it does not already exist. Replace
# ca.crt with the path to your registry/fileserver CA certificate.
if ! kubectl get secret "{{.CACertSecretName}}" -n "${NAMESPACE}" >/dev/null 2>&1; then
  echo "==> Creating CA secret {{.CACertSecretName}} in ${NAMESPACE}"
  kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
  kubectl create secret generic "{{.CACertSecretName}}" \
    --from-file=ca.crt="${CA_CERT_PATH:-./ca.crt}" \
    -n "${NAMESPACE}"
fi
{{- end}}

echo "==> Installing kcm ${KCM_VERSION} from ${CHART}"
echo "    namespace: ${NAMESPACE}"
echo "    values:    ${VALUES}"

helm install kcm "${CHART}" \
  --version "${KCM_VERSION}" \
  -n "${NAMESPACE}" \
  --create-namespace \
  -f "${VALUES}"

echo ""
echo "==> Helm install submitted. Allow 5-10 minutes to stabilize, then run 05-verify.sh."
