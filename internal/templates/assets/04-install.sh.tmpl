#!/usr/bin/env bash
#
# 04-install.sh  —  AIRGAPPED CLUSTER SIDE
#
# Installs k0rdent Enterprise (kcm) from your private OCI registry using the
# generated values file. Generated by airgapdeploy.
#
# Prerequisites: helm>=3.16.3 and kubectl configured against the management
# cluster (Kubernetes >= 1.30). Run the fileserver step (02) first.
set -euo pipefail

NAMESPACE="${NAMESPACE:-{{.Namespace}}}"
KCM_VERSION="${KCM_VERSION:-{{.KcmVersion}}}"
CHART="${CHART:-{{.ChartsRepoURL}}/k0rdent-enterprise}"
VALUES="${VALUES:-$(dirname "$0")/03-values.yaml}"
{{- if .UsesCustomTLS}}

# --- TLS: {{.TLSModeLabel}} ---
# The registry{{if .FileserverIsHTTPS}}/fileserver{{end}} presents a
# {{if eq .TLSMode "self-signed"}}self-signed certificate{{else}}certificate signed by a custom CA{{end}}.
# Create a secret containing the trusted certificate (as ca.crt) before install.
# CA_CERT_PATH must point to:
{{- if eq .TLSMode "self-signed"}}
#   the registry's self-signed certificate (PEM).
{{- else}}
#   the CA bundle (PEM) that signed the registry certificate.
{{- end}}
CA_CERT_PATH="${CA_CERT_PATH:-{{.CACertPath}}}"
if ! kubectl get secret "{{.CACertSecretName}}" -n "${NAMESPACE}" >/dev/null 2>&1; then
  if [[ ! -f "${CA_CERT_PATH}" ]]; then
    echo "ERROR: CA certificate not found at ${CA_CERT_PATH}." >&2
    echo "Set CA_CERT_PATH to your certificate file and re-run." >&2
    exit 1
  fi
  echo "==> Creating CA secret {{.CACertSecretName}} in ${NAMESPACE} from ${CA_CERT_PATH}"
  kubectl create namespace "${NAMESPACE}" --dry-run=client -o yaml | kubectl apply -f -
  kubectl create secret generic "{{.CACertSecretName}}" \
    --from-file=ca.crt="${CA_CERT_PATH}" \
    -n "${NAMESPACE}"
else
  echo "==> CA secret {{.CACertSecretName}} already exists in ${NAMESPACE}, skipping"
fi
{{- end}}

echo "==> Installing kcm ${KCM_VERSION} from ${CHART}"
echo "    namespace: ${NAMESPACE}"
echo "    values:    ${VALUES}"

helm install kcm "${CHART}" \
  --version "${KCM_VERSION}" \
  -n "${NAMESPACE}" \
  --create-namespace \
  -f "${VALUES}"

echo ""
echo "==> Helm install submitted. Allow 5-10 minutes to stabilize, then run 05-verify.sh."
